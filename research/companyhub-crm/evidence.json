  "claims": [
    {
      "statement": "CompanyHub was publicly available as an Android CRM by September 27, 2016.",
      "kind": "fact",
      "status": "verified",
      "sourceIds": [
        "android-history"
      ]
    },
    {
      "statement": "CompanyHub combines contacts and deals with custom fields, custom record types, reports, email sync, forms, automation, and detailed access rules.",
      "kind": "fact",
      "status": "verified",
      "sourceIds": [
        "official-start",
        "official-email"
      ]
    },
    {
      "statement": "Productivity costs $21 per user monthly or $15 with annual billing. Higher plans add automation and advanced sales tools, with monthly prices reaching $64 per user.",
      "kind": "fact",
      "status": "verified",
      "sourceIds": [
        "official-pricing"
      ]
    },
    {
      "statement": "Email is synced every few hours, sent mail may not appear in contact history until the next sync, and the initial import covers six months.",
      "kind": "fact",
      "status": "verified",
      "sourceIds": [
        "official-email"
      ]
    },
    {
      "statement": "Ease, flexible custom records, follow-up focus, and responsive support are common strengths.",
      "kind": "reported-pattern",
      "status": "supported",
      "sourceIds": [
        "g2",
        "capterra",
        "trustpilot"
      ]
    },
    {
      "statement": "The interface can feel dated or less polished, while integration and installed-app friction appears in a small number of reports.",
      "kind": "reported-pattern",
