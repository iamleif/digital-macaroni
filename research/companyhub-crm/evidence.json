  "scoreRationale": {
    "onboarding": "The core contact and deal views are approachable, but custom records and permissions need a deliberate setup.",
    "product": "Customization is strong for a smaller CRM. Email delay, integration uncertainty, and dated presentation need testing.",
    "support": "Support is repeatedly praised, though no request was tested.",
    "billing": "Entry pricing is clear and reasonable for a small sales team. Higher plan and setup needs require a written quote.",
    "overall": "CompanyHub suits a small team whose sales records do not fit a standard CRM. It is less convincing when polish, a large integration market, or real-time email history matters most."
  },
  "conflictsAndUnknowns": [
    "The interface is described as both simple and dated.",
    "The positive sample is modest and lacks strong community corroboration.",
