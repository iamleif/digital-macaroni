  "scoreRationale": {
    "onboarding": "Connecting a few profiles and filling a calendar is straightforward, though every network has its own limits.",
    "product": "Scheduling and repeated-content tools are strong. Reporting, permissions, and mobile depth are less convincing for a larger agency.",
    "support": "Responsive support is a common positive theme, but it was not tested directly.",
    "billing": "The entry price is low, but the total must be calculated from the real number of profiles and teammates.",
    "overall": "Publer is a good publishing tool for creators and small teams that schedule in batches. Teams buying for deep reports or strict approvals should look harder."
  },
  "conflictsAndUnknowns": [
    "Public ratings are exceptionally positive, but some community mentions are promotional.",
    "No scheduled posts were published in a hands-on test.",
    "Network APIs and supported post types can change after research."
  ]
